{
  "name": "oysterpilot",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --stream dev",
    "build": "pnpm -C apps/web build",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && pnpm -C apps/api deploy",
    "test": "pnpm -C apps/api test && pnpm -C apps/web test",
    "eval": "node tests/oysterman_eval/run.ts",
    "prepare": "git config core.hooksPath .githooks"
  },
  "packageManager": "pnpm@12.16.1"
}
