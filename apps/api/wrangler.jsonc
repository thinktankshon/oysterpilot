{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oysterpilot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.yaml"], "fallthrough": true }],
  "observability": { "enabled": true },
  // フロント（Vite の build 成果物）を同じ Worker から配信する。/api/* だけ Worker が処理する。
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oysterpilot",
      // `wrangler d1 create oysterpilot` の出力で置き換える（ローカル開発は仮の値で動く）
      "database_id": "65c0f443-3937-47de-b410-6600e4c1f1f1",
      "migrations_dir": "migrations"
    }
  ]
  // secrets（wrangler secret put）: ANTHROPIC_API_KEY, DEMO_KEY
}
